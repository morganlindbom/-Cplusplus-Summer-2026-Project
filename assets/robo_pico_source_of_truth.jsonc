  "power_rules_source": {
    "page": 6,
    "section": "3. SPECIFICATIONS",
    "classification": "datasheet",
    "notes": [
      "Voltage for the DC motor and servo is equal to power input voltage subject to the documented power-path cases.",
      "Connecting LiPo and VIN at the same time is not recommended, although the datasheet states that it is safe.",
    ],
  },
  "resource_conflicts": [
    {
      "id": "maker_port_grove_2",
      "resources": ["maker_port", "grove_port_2"],
      "gpios": [2, 3],
      "severity": "exclusive_or_shared_bus",
      "classification": "datasheet",
      "reason": "Datasheet explicitly states that Maker Port pins are shared with Grove Port 2.",
    },
    {
      "id": "grove_5b_grove_6a",
      "resources": ["grove_port_5_pin_b", "grove_port_6_pin_a"],
      "gpios": [26],
      "severity": "same_gpio",
      "classification": "derived",
      "reason": "Both connector positions are mapped to GPIO26 in the datasheet.",
    },
    {
      "id": "grove_7b_vbat_sense",
      "resources": ["grove_port_7_pin_b", "vbat_sense"],
      "gpios": [28],
      "severity": "conditional_conflict",
      "classification": "derived",
      "reason": "Both use GPIO28/ADC2. VBAT Sense is electrically connected only when its solder jumper is enabled.",
    },
  ],
  "validation_rules": [
    {
      "id": "motor_pwm_frequency",
      "applies_to": ["dc_motor_channel_1", "dc_motor_channel_2"],
      "rule": "requested_pwm_frequency_khz <= 20.0",
      "on_failure": "error",
      "message": "ROBO-PICO motor driver PWM frequency must not exceed 20 kHz according to the board datasheet.",
    },
    {
      "id": "motor_continuous_current",
      "applies_to": ["dc_motor_channel_1", "dc_motor_channel_2"],
      "rule": "continuous_current_a <= 1.0",
      "on_failure": "error",
      "message": "ROBO-PICO maximum continuous DC motor current is 1 A per channel.",
    },
    {
      "id": "motor_peak_current",
      "applies_to": ["dc_motor_channel_1", "dc_motor_channel_2"],
      "rule": "peak_current_a <= 1.5 && peak_duration_s < 5",
      "on_failure": "error",
      "message": "ROBO-PICO peak DC motor current is limited to 1.5 A per channel for less than 5 seconds.",
    },
    {
      "id": "board_input_voltage",
      "applies_to": ["vin_terminal", "lipo_battery_connector", "usb_power"],
      "rule": "input_voltage_v >= 3.6 && input_voltage_v <= 6.0",
      "on_failure": "error",
      "message": "ROBO-PICO documented power input range is 3.6-6 V.",
    },
    {
      "id": "lipo_vin_combination",
      "applies_to": ["lipo_battery_connector", "vin_terminal"],
      "rule": "not (lipo_connected && vin_connected)",
      "on_failure": "warning",
      "message": "The ROBO-PICO datasheet does not recommend connecting LiPo and VIN at the same time, although it states that doing so is safe.",
    },
    {
      "id": "vbat_sense_gpio28_claim",
      "applies_to": ["vbat_sense", "grove_port_7_pin_b"],
      "rule": "not (vbat_sense_jumper_enabled && grove_7b_claims_gpio28)",
      "on_failure": "error",
      "message": "GPIO28/ADC2 cannot be independently assigned to Grove Port 7B while the VBAT Sense jumper is enabled.",
    },
  ],
